#!name=帆书模块（统一版）
#!desc=帆书（原樊登读书）全局去广告精简版。仅保留 Yuheng0101 9 条响应改写规则；删除所有重复副本与未匹配模块脚本。
#!category=Enhancement
#!system=ios

[Script]
# 以下脚本由 Yuheng0101 维护，直接引用上游 Raw 链接。如需更新规则请修改 Yuheng0101 的 No_Ads.js 脚本。
1_fanshu_v105_category     = type=http-response,pattern=^https?:\/\/g[a-z0-9-]+\.dushu365\.com\/chief-orch\/home\/bookPortal\/v105\/category,requires-body=true,max-size=1048576,timeout=10,script-path=https://raw.githubusercontent.com/Yuheng0101/X/main/Scripts/FanShu/No_Ads.js
2_fanshu_banner_get       = type=http-response,pattern=^https?:\/\/g[a-z0-9-]+\.dushu365\.com\/abtest-front\/banner-modular\/get,requires-body=true,max-size=1048576,timeout=10,script-path=https://raw.githubusercontent.com/Yuheng0101/X/main/Scripts/FanShu/No_Ads.js
3_fanshu_book_channel     = type=http-response,pattern=^https?:\/\/g[a-z0-9-]+\.dushu365\.com\/resource-orchestration-system\/book\/channel\/v100\/info,requires-body=true,max-size=1048576,timeout=10,script-path=https://raw.githubusercontent.com/Yuheng0101/X/main/Scripts/FanShu/No_Ads.js
4_fanshu_user_profile    = type=http-response,pattern=^https?:\/\/g[a-z0-9-]+\.dushu365\.com\/fs-member\/user\/profile\/v100\/detail,requires-body=true,max-size=1048576,timeout=10,script-path=https://raw.githubusercontent.com/Yuheng0101/X/main/Scripts/FanShu/No_Ads.js
5_fanshu_forApp          = type=http-response,pattern=^https?:\/\/g[a-z0-9-]+\.dushu365\.com\/chief-orch\/home\/bookPortal\/v111\/forApp,requires-body=true,max-size=1048576,timeout=10,script-path=https://raw.githubusercontent.com/Yuheng0101/X/main/Scripts/FanShu/No_Ads.js
6_fanshu_myPage          = type=http-response,pattern=^https?:\/\/g[a-z0-9-]+\.dushu365\.com\/sns-orchestration-system\/homePage\/api\/v100\/myPage,requires-body=true,max-size=1048576,timeout=10,script-path=https://raw.githubusercontent.com/Yuheng0101/X/main/Scripts/FanShu/No_Ads.js
7_fanshu_taskList        = type=http-response,pattern=^https?:\/\/g[a-z0-9-]+\.dushu365\.com\/task-orchestration\/taskCenter\/api\/v101\/taskList,requires-body=true,max-size=1048576,timeout=10,script-path=https://raw.githubusercontent.com/Yuheng0101/X/main/Scripts/FanShu/No_Ads.js
8_fanshu_book_content    = type=http-response,pattern=^https?:\/\/g[a-z0-9-]+\.dushu365\.com\/resource-orchestration-system\/book\/v101\/content,requires-body=true,max-size=1048576,timeout=10,script-path=https://raw.githubusercontent.com/Yuheng0101/X/main/Scripts/FanShu/No_Ads.js
9_fanshu_ceiltip         = type=http-response,pattern=^https?:\/\/g[a-z0-9-]+\.dushu365\.com\/user-orchestration\/user\/api\/v101\/ceiltip,requires-body=true,max-size=1048576,timeout=10,script-path=https://raw.githubusercontent.com/Yuheng0101/X/main/Scripts/FanShu/No_Ads.js

[MITM]
hostname = %APPEND% dushu365.com, *.dushu365.com, g1.dushu365.com, g2.dushu365.com, gw1.dushu365.com, gw2.dushu365.com, gateway-api.dushu365.com