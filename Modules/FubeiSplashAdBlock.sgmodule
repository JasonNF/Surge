#!name=Fubei Splash Ad Block
#!desc=关闭付呗 com.fshows.lifecircle.launch.info 响应中的三项开屏广告开关，不影响支付、账单、首页导航或其他业务接口。
#!category=Ad Blocking
#!system=ios

[Script]
fubei_splash_block = type=http-response,pattern=^https:\/\/fubeiappgw\.51youdian\.com\/newgateway$,requires-body=true,max-size=1048576,script-path=https://raw.githubusercontent.com/JasonNF/Surge/main/Scripts/fubei_splash_block.js,timeout=5

[MITM]
# Keep MITM scope to the multiplexed API host; the script changes only matching launch-info payloads.
hostname = %APPEND% fubeiappgw.51youdian.com
